# The default runs curated local cases and makes no inference calls.
CONTRACTLENS_PROVIDER=curated
PORT=4183
# Optional real inference. Keep keys in .env, never in browser code or a public repo.
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MAX_CALLS=10
# Set CONTRACTLENS_PROVIDER=nebius after configuring the key and explicit NVIDIA model.
